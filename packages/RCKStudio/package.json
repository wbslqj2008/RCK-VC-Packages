{
  "schemaVersion": 1,
  "id": "rck.rckstudio",
  "name": "RCKStudio",
  "type": "addon",
  "version": "4.1.0",
  "description": "VC 최적화 Python IDE",
  "restartRequired": true,
  "systemPackage": false,
  "vcVersions": [
    "5.0",
    "5.1"
  ],
  "releaseNotes": [
    "이미지 제너레이터, 모델링 뷰러 추가"
  ],
  "files": [
    {
      "source": "payload/AvalonDock.dll",
      "destination": "vcRoot/AvalonDock.dll"
    },
    {
      "source": "payload/ICSharpCode.AvalonEdit.dll",
      "destination": "vcRoot/ICSharpCode.AvalonEdit.dll"
    },
    {
      "source": "payload/Plugin.RCKStudio.dll",
      "destination": "vcRoot/Plugin.RCKStudio.dll"
    },
    {
      "source": "payload/log4net.dll",
      "destination": "vcRoot/log4net.dll"
    },
    {
      "source": "payload/Plugin.RCKStudio.dll.config",
      "destination": "vcRoot/Plugin.RCKStudio.dll.config"
    }
  ]
}
