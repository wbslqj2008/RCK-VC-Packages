{
  "schemaVersion": 1,
  "id": "rck.rckstudio",
  "name": "RCKStudio",
  "type": "addon",
  "version": "3.1.8",
  "description": "VC 최적화 Python IDE",
  "restartRequired": true,
  "systemPackage": false,
  "vcVersions": [
    "5.0",
    "5.1"
  ],
  "releaseNotes": [
    "파이썬 리딩방식 변경, AI 툴 개선 및 직렬화 구조 재변경, VC Py3이 우선 탐색 후 (깊이우선) .NET 애드온 동작하는 방식으로 변경, 성능향상,Py2 or Py3 선택기추가"
  ],
  "files": [
    {
      "source": "payload/AvalonDock.dll",
      "destination": "vcRoot/AvalonDock.dll"
    },
    {
      "source": "payload/ICSharpCode.AvalonEdit.dll",
      "destination": "vcRoot/ICSharpCode.AvalonEdit.dll"
    },
    {
      "source": "payload/IronPython.dll",
      "destination": "vcRoot/IronPython.dll"
    },
    {
      "source": "payload/IronPython.Modules.dll",
      "destination": "vcRoot/IronPython.Modules.dll"
    },
    {
      "source": "payload/Microsoft.Dynamic.dll",
      "destination": "vcRoot/Microsoft.Dynamic.dll"
    },
    {
      "source": "payload/Microsoft.Scripting.dll",
      "destination": "vcRoot/Microsoft.Scripting.dll"
    },
    {
      "source": "payload/Microsoft.Scripting.Metadata.dll",
      "destination": "vcRoot/Microsoft.Scripting.Metadata.dll"
    },
    {
      "source": "payload/Plugin.RCKStudio.dll",
      "destination": "vcRoot/Plugin.RCKStudio.dll"
    }
  ]
}
