    "RCKStudio에서 사용하지 않는 IronPython 및 Microsoft.Scripting 의존성 제거"
  ],
  "files": [
    {
      "source": "payload/AvalonDock.dll",
      "destination": "vcRoot/AvalonDock.dll"
    },
    {
      "source": "payload/ICSharpCode.AvalonEdit.dll",
      "destination": "vcRoot/ICSharpCode.AvalonEdit.dll"
    },
    {
      "source": "payload/Plugin.RCKStudio.dll",
      "destination": "vcRoot/Plugin.RCKStudio.dll"
    }
  ]
}
